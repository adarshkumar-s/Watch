<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/omni_bg"
    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="22dp" android:paddingBottom="14dp">

    <TextView android:text="DIAGNOSTICS" android:textColor="@color/omni_green"
        android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/logCount" android:text=""
        android:textColor="@color/omni_text_dim" android:textSize="11sp" android:layout_marginTop="4dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logCopy" style="@style/OmniButton.Secondary"
            android:text="COPY LOG" android:textSize="11sp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logExport" style="@style/OmniButton.Primary"
            android:text="EXPORT LOG" android:textSize="11sp" android:layout_marginStart="6dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logClear" style="@style/OmniButton.Secondary"
            android:text="CLEAR LOG" android:textSize="11sp" android:layout_marginStart="6dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logCorrelate" style="@style/OmniButton.Ghost"
        android:text="QR ↔ BLE CORRELATION"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="44dp" />

    <TextView style="@style/OmniSectionLabel" android:text="CONNECTION / PROTOCOL LOG"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <ScrollView android:background="@color/omni_panel"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/logText"
            android:textIsSelectable="true"
            android:textColor="@color/omni_text" android:textSize="11sp" android:typeface="monospace"
            android:padding="12dp" android:lineSpacingExtra="2dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logBack" style="@style/OmniButton.Secondary"
        android:text="BACK"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="44dp" />
</LinearLayout>
