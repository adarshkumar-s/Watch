<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/omni_bg"
    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="22dp" android:paddingBottom="12dp">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:id="@+id/gattTitle" android:text="Watch"
                android:textColor="@color/omni_text" android:textSize="18sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/gattSub" android:text=""
                android:textColor="@color/omni_text_dim" android:textSize="11sp" android:typeface="monospace"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/gattStatePill" android:text="IDLE"
            android:textColor="@color/omni_green" android:textSize="10sp" android:textStyle="bold"
            android:background="@color/omni_panel_2" android:gravity="center"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:id="@+id/gattRssi" android:text="RSSI —"
        android:textColor="@color/omni_text_dim" android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:orientation="horizontal" android:layout_marginTop="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/gattReadRssi" style="@style/OmniButton.Secondary"
            android:text="READ RSSI" android:textSize="12sp"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/gattDisconnect" style="@style/OmniButton.Secondary"
            android:text="DISCONNECT" android:textSize="12sp" android:layout_marginStart="8dp"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/gattBack" style="@style/OmniButton.Secondary"
            android:text="BACK" android:textSize="12sp" android:layout_marginStart="8dp"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" />
    </LinearLayout>

    <TextView style="@style/OmniSectionLabel" android:text="GATT DATABASE (READ/DISCOVERY ONLY)"
        android:layout_marginTop="12dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/gattList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" />

    <TextView android:text="No commands are written to characteristics. NOTIFY toggles only set the standard CCCD descriptor — and only when you tap them."
        android:textColor="@color/omni_text_muted" android:textSize="10sp" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
