<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/omni_panel" android:padding="12dp"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout android:orientation="vertical"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <TextView android:id="@+id/rowName" android:textColor="@color/omni_text"
            android:textSize="15sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/rowAddress" android:textColor="@color/omni_text_dim"
            android:textSize="12sp" android:typeface="monospace" android:layout_marginTop="2dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/rowHint" android:textColor="@color/omni_cyan"
            android:textSize="11sp" android:layout_marginTop="2dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:id="@+id/rowRssi" android:textColor="@color/omni_green"
        android:textSize="11sp" android:typeface="monospace" android:gravity="center"
        android:layout_marginStart="8dp"
        android:layout_width="66dp" android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rowConnect" style="@style/OmniButton.Primary"
        android:text="CONNECT" android:textSize="11sp"
        android:insetTop="0dp" android:insetBottom="0dp"
        android:layout_marginStart="8dp"
        android:layout_width="92dp" android:layout_height="42dp" />
</LinearLayout>
