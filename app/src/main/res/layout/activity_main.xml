<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/omni_bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="vertical"
            android:paddingStart="22dp" android:paddingEnd="22dp"
            android:paddingTop="28dp" android:paddingBottom="18dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <!-- Header -->
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView android:text="OMNITRIX" android:textColor="@color/omni_green"
                        android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.08"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:text="CALIBER 2881  •  DIAGNOSTIC LINK"
                        android:textColor="@color/omni_text_dim" android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView android:id="@+id/connectionPill" android:text="DIAGNOSTIC MODE"
                    android:textColor="@color/omni_green" android:textSize="10sp" android:textStyle="bold"
                    android:gravity="center" android:background="@color/omni_panel_2"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Watch status panel -->
            <TextView style="@style/OmniSectionLabel" android:text="WATCH STATUS"
                android:layout_marginTop="22dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="vertical" android:background="@color/omni_panel"
                android:padding="16dp" android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/watchStatus" android:text="● OFFLINE"
                    android:textColor="@color/omni_text_muted" android:textSize="16sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/watchDevice" android:text="Device  •  —"
                    android:textColor="@color/omni_text" android:textSize="13sp" android:layout_marginTop="10dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/watchFirmware" android:text="Firmware  •  —"
                    android:textColor="@color/omni_text" android:textSize="13sp" android:layout_marginTop="4dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/watchBattery" android:text="Battery  •  —"
                    android:textColor="@color/omni_text" android:textSize="13sp" android:layout_marginTop="4dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Primary diagnostic actions -->
            <TextView style="@style/OmniSectionLabel" android:text="DIAGNOSTIC ACTIONS"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQr" style="@style/OmniButton.Primary"
                android:text="SCAN WATCH QR"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="54dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBleScan" style="@style/OmniButton.Secondary"
                android:text="SCAN BLUETOOTH"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="50dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnectedWatch" style="@style/OmniButton.Secondary"
                android:text="CONNECTED WATCH"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="50dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnostics" style="@style/OmniButton.Secondary"
                android:text="DIAGNOSTICS"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="50dp" />

            <!-- Omnitrix action wheel -->
            <TextView style="@style/OmniSectionLabel" android:text="OMNITRIX CONTROLS"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <GridLayout android:columnCount="3"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actScan" style="@style/OmniButton.Ghost" android:text="SCAN"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_columnWeight="1" android:layout_margin="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actData" style="@style/OmniButton.Ghost" android:text="DATA"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_columnWeight="1" android:layout_margin="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actEnergy" style="@style/OmniButton.Ghost" android:text="ENERGY"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_columnWeight="1" android:layout_margin="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actAlert" style="@style/OmniButton.Ghost" android:text="ALERT"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_columnWeight="1" android:layout_margin="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actFind" style="@style/OmniButton.Ghost" android:text="FIND"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_columnWeight="1" android:layout_margin="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actSettings" style="@style/OmniButton.Ghost" android:text="SETTINGS"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_columnWeight="1" android:layout_margin="4dp" />
            </GridLayout>

            <TextView android:text="READ/DISCOVERY MODE — no commands are sent to the watch. v1.0-diagnostic"
                android:textColor="#3E483F" android:textSize="9sp" android:gravity="center"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
